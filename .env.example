# Variables d'environnement - Fiatope Invest
# Copier ce fichier et configurer dans EasyPanel > Environment Variables

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=fiatopinvest@gmail.com
SMTP_PASSWORD=your_app_password_here

# Email destinataire des formulaires de contact
MAIL_FROM=fiatopinvest@gmail.com
MAIL_TO=fiatopinvest@gmail.com
MAIL_TO_NAME=Fiatope Invest
